# Genesis OS — Signal Intelligence configuration.
# With NO variables set, the system boots in MOCK mode: every external tool
# (Parallel, Gemini) runs against deterministic fixtures so the full mission
# flow is demonstrable from a clean clone.

# --- Parallel (External Intelligence substrate; required for LIVE research) ---
PARALLEL_API_KEY=

# --- Gemini (cognition; either an API key OR Vertex AI project config) ---
GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# "-latest" alias tracks the current flash model (pinned versions can age out for new accounts)
GEMINI_MODEL=gemini-flash-latest

# --- DataHub knowledge graph (optional; local JSONL graph store used when unset) ---
DATAHUB_GMS_URL=

# --- Storage / behavior ---
GENESIS_DATA_DIR=./data
# Force mock mode even when keys are present (demo safety switch):
GENESIS_MOCK=
